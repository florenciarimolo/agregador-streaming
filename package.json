{
  "name": "UpNext",
  "private": true,
  "version": "1.9.5",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "generate-flags": "tsx scripts/generate-flags.ts",
    "prebuild": "npm run generate-flags",
    "build": "nuxt build",
    "dev": "cross-env NODE_OPTIONS=--no-warnings nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "cross-env NODE_OPTIONS=--no-warnings nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt prepare && vue-tsc -b",
    "clean": "rm -rf .nuxt .output .nitro .nitro.json node_modules/.vite node_modules/.cache vite.localStoragePlugin.js && find . -type f \\( -name '*.vue.js' -o -name 'app.vue.js' -o -name 'error.vue.js' -o -name 'nuxt.config.js' -o -name '*.tsbuildinfo' \\) ! -path '*/node_modules/*' -delete && find types server/api server/middleware server/plugins server/routes server/utils middleware components pages layouts composables utils stores services config constants i18n plugins -type f -name '*.js' ! -path '*/node_modules/*' -delete 2>/dev/null || true && find . -type f -path '*/vite.*.js' ! -path '*/node_modules/*' -delete 2>/dev/null || true",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:migration:new": "supabase migration new",
    "supabase:migration:up": "supabase migration up",
    "supabase:migration:down": "supabase migration down",
    "supabase:db:push": "supabase db push",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:diff": "supabase db diff",
    "supabase:link": "supabase link",
    "supabase:functions:deploy": "supabase functions deploy",
    "supabase:functions:deploy:process-title-status": "supabase functions deploy process-title-status",
    "check-translations": "node scripts/check-translations.js"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/sitemap": "^7.5.0",
    "@nuxtjs/supabase": "^1.6.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@supabase/supabase-js": "^2.89.0",
    "aos": "^2.3.4",
    "axios": "^1.13.2",
    "nuxt": "^4.2.2",
    "pinia": "^2.3.1",
    "resend": "^6.6.0",
    "typescript-eslint": "^8.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.7.4",
    "supabase": "^2.70.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "vue-tsc": "^3.2.1"
  }
}
