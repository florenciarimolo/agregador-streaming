    "typecheck": "nuxt prepare && vue-tsc -b"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/supabase": "^1.6.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.9.0",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.13.2",
    "nuxt": "^4.2.2",
    "pinia": "^2.3.1",
    "typescript-eslint": "^8.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vue-tsc": "^3.2.1"
  }
