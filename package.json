{
  "name": "UpNext",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "NODE_OPTIONS='--no-warnings' nuxt dev",
